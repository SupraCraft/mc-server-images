{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:supracraft:schema:causal-kernel:1",
  "title": "SupraCraft cross-domain causal kernel v1",
  "description": "Additive evidence/provenance envelope for exact-version Minecraft Java causal projections. Domain-specific semantics remain adapter-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "edition",
    "minecraft_version",
    "projection_id",
    "source",
    "entities",
    "events",
    "edges",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "supracraft-causal-kernel/1"
    },
    "edition": {
      "const": "java"
    },
    "minecraft_version": {
      "type": "string",
      "minLength": 1
    },
    "projection_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "source_schema",
        "evidence_refs"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "source_schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "world_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "domains",
          "position",
          "dimension",
          "state_ref",
          "knowledge_state",
          "ports",
          "evidence_refs"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "electrical",
                "mechanical",
                "inventory",
                "programmable",
                "presentation"
              ]
            }
          },
          "position": {
            "oneOf": [
              {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "dimension": {
            "type": [
              "string",
              "null"
            ]
          },
          "state_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "knowledge_state": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "unknown"
            ]
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port_id",
                "domain",
                "direction",
                "semantic_type",
                "knowledge_state"
              ],
              "properties": {
                "port_id": {
                  "type": "string",
                  "minLength": 1
                },
                "domain": {
                  "type": "string",
                  "enum": [
                    "electrical",
                    "mechanical",
                    "inventory",
                    "programmable",
                    "presentation"
                  ]
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "input",
                    "output",
                    "bidirectional",
                    "state",
                    "unknown"
                  ]
                },
                "semantic_type": {
                  "type": "string",
                  "minLength": 1
                },
                "knowledge_state": {
                  "type": "string",
                  "enum": [
                    "observed",
                    "inferred",
                    "unknown"
                  ]
                }
              }
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "domain",
          "event_type",
          "subject_entity_ids",
          "event_time",
          "knowledge_state",
          "state_revision",
          "evidence_refs"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "enum": [
              "electrical",
              "mechanical",
              "inventory",
              "programmable",
              "presentation"
            ]
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "subject_entity_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "event_time": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "game_tick",
              "microstep_or_order"
            ],
            "properties": {
              "game_tick": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "microstep_or_order": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "knowledge_state": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "unknown"
            ]
          },
          "state_revision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before_ref",
              "after_ref"
            ],
            "properties": {
              "before_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "after_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "edge_kind",
          "semantic_type",
          "source",
          "target",
          "event_id",
          "knowledge_state",
          "evidence_refs"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 1
          },
          "edge_kind": {
            "type": "string",
            "enum": [
              "domain",
              "transducer",
              "mutation",
              "observation"
            ]
          },
          "semantic_type": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/endpoint"
          },
          "target": {
            "$ref": "#/$defs/endpoint"
          },
          "event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "knowledge_state": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "port_id"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "port_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
