{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:supracraft:schema:causal-event:1",
  "title": "SupraCraft causal event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seq",
    "event_type",
    "monotonic_ns",
    "thread_id",
    "tick",
    "data"
  ],
  "properties": {
    "schema": {"const": "supracraft-causal-event/1"},
    "seq": {"type": "integer", "minimum": 1},
    "event_type": {
      "enum": [
        "trace_start",
        "trace_end",
        "tick_start",
        "tick_end",
        "block_state_write",
        "scheduled_tick_enqueue",
        "neighbor_notify",
        "redstone_power_query",
        "redstone_power_result",
        "block_power_query",
        "block_power_result",
        "wire_recompute_start",
        "wire_recompute_end",
        "command_block_neighbor",
        "command_block_scheduled_tick",
        "command_trigger_start",
        "command_trigger_end",
        "command_dispatch",
        "packet_send"
      ]
    },
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "thread_id": {"type": "integer", "minimum": 1},
    "tick": {"type": "integer", "minimum": -1},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "maxLength": 96
        },
        "trace_schema": {"const": "supracraft-causal-trace/1"},
        "dropped_events": {"type": "integer", "minimum": 0},
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "z": {"type": "integer"},
        "value": {"type": "integer"},
        "command_verb": {
          "type": "string",
          "pattern": "^[a-z0-9_:-]+$",
          "maxLength": 64
        },
        "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "success_count": {"type": "integer"},
        "dispatch_kind": {
          "enum": ["performCommand", "performPrefixedCommand"]
        },
        "packet_class": {"enum": ["chat"]},
        "packet_position": {"type": "integer", "minimum": 0, "maximum": 255},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_class": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.$/]+$",
          "maxLength": 160
        }
      }
    }
  }
}
