{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:supracraft:schema:causal-symbol-inventory:1",
  "title": "SupraCraft exact Minecraft causal microscope symbol inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "channel",
    "minecraft_version",
    "java_major",
    "symbol_mode_required",
    "server_sha1",
    "classes",
    "qualification_status",
    "boundaries"
  ],
  "properties": {
    "schema": {
      "const": "supracraft-causal-symbol-inventory/1"
    },
    "channel": {
      "enum": ["release", "snapshot"]
    },
    "minecraft_version": {
      "type": "string",
      "minLength": 1
    },
    "java_major": {
      "type": "integer",
      "minimum": 8
    },
    "symbol_mode_required": {
      "const": "unobfuscated"
    },
    "server_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "runtime_class",
          "class_sha256",
          "method_count",
          "methods",
          "name_token_candidates"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "runtime_class": {
            "type": "string"
          },
          "class_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "method_count": {
            "type": "integer",
            "minimum": 1
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/method"
            }
          },
          "name_token_candidates": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/method"
            }
          }
        }
      }
    },
    "qualification_status": {
      "const": "inventory_only_not_hook_qualified"
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "descriptor",
        "declaration_sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "descriptor": {
          "type": "string",
          "minLength": 1
        },
        "declaration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
