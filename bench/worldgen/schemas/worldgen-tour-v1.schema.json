{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupraCraft/mc-server-images/bench/worldgen/schemas/worldgen-tour-v1.schema.json",
  "title": "Worldgen Tour v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "sites"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 3},
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site_id", "category", "position", "reason"],
        "properties": {
          "site_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "enum": ["top-interest", "bottom-dull", "representative", "anomaly-defect", "spawn-progression", "ecology-resource", "random-control"]},
          "position": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "look_at": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "reason": {"type": "string", "minLength": 1},
          "teleport": {"type": ["string", "null"]},
          "metrics_ref": {"type": ["string", "null"]}
        }
      }
    }
  }
}
