{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SupraCraft/mc-server-images/bench/worldgen/schemas/generator-pipeline-v1.schema.json",
  "title": "World Generator Pipeline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_id", "profile", "seed", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "pipeline_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "profile": {"type": "string", "minLength": 1},
    "seed": {"type": ["integer", "string"]},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "adapter_id", "owns", "preserves", "validation_gate"],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "adapter_id": {"type": "string", "minLength": 1},
          "config_ref": {"type": ["string", "null"]},
          "owns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "preserves": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "validation_gate": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
